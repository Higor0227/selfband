    <string name="onboarding_welcome">Boas-vindas ao Selfband</string>
    <string name="onboarding_welcome_text">Grave você mesmo cada parte de uma música, uma de cada vez, com vídeo e tudo sincronizado. Alguns passos para deixar tudo pronto. Primeiro, as permissões:</string>
    <string name="onboarding_perm_mic">Microfone</string>
    <string name="onboarding_perm_mic_text">Para gravar o som e medir a latência.</string>
    <string name="onboarding_perm_camera">Câmera</string>
    <string name="onboarding_perm_camera_text">Para gravar o vídeo de cada trilha. Sem ela, as trilhas ficam só com áudio.</string>
    <string name="onboarding_perm_notifications">Notificações</string>
    <string name="onboarding_perm_notifications_text">Para mostrar o progresso da exportação com o app em segundo plano.</string>
    <string name="onboarding_perm_granted">Permitido</string>
    <string name="onboarding_perm_missing">Não permitido</string>
    <string name="onboarding_perm_allow">Permitir</string>
    <string name="onboarding_perm_later">Você pode permitir depois nas configurações do app no Android. O app também pede de novo quando precisar.</string>
    <string name="onboarding_perm_all_granted">Tudo certo.</string>
    <string name="onboarding_setup_title">Como você grava?</string>
    <string name="onboarding_setup_phone">Microfone do celular</string>
    <string name="onboarding_setup_phone_text">O microfone do próprio celular. Ouça as trilhas por fone, senão elas vazam para a gravação nova.</string>
    <string name="onboarding_setup_wired">Fone com fio</string>
    <string name="onboarding_setup_wired_text">Fone ou headset com cabo, gravando com o microfone do celular ou do headset.</string>
    <string name="onboarding_setup_usb">Interface USB</string>
    <string name="onboarding_setup_usb_text">Placa de som, pedaleira ou microfone USB.</string>
    <string name="onboarding_setup_bluetooth">Bluetooth</string>
    <string name="onboarding_setup_bluetooth_text">Só para ouvir, com latência alta (150 a 300 ms). O som é gravado pelo microfone do celular.</string>
    <string name="onboarding_connected">Conectado agora: %1$s</string>
    <string name="onboarding_setup_not_connected">Esse equipamento não está conectado agora. Conecte antes de calibrar: o app detecta sozinho.</string>
    <string name="onboarding_calibration_title">Calibração</string>
    <string name="onboarding_calibration_text">Mede o atraso entre o que o celular toca e o que ele grava, para as trilhas ficarem alinhadas. Fica salva para esta saída e entrada, e volta sozinha quando elas forem conectadas de novo.</string>
    <string name="onboarding_calibration_no_mic">Sem a permissão do microfone não dá para medir a latência. Você pode calibrar depois no gravador.</string>
    <string name="onboarding_engine_error">Não foi possível abrir o áudio: %1$s</string>
    <string name="onboarding_output">Saída: %1$s</string>
    <string name="onboarding_input">Entrada: %1$s</string>
    <string name="onboarding_already_calibrated">Já calibrada: ida e volta de %1$s ms.</string>
    <string name="onboarding_bluetooth_warning">O Bluetooth soma 150 a 300 ms e pode variar. Calibre com o fone que você vai usar; fone com fio é mais preciso.</string>
    <string name="onboarding_recommended">Recomendado</string>
    <string name="onboarding_start">Iniciar</string>
    <string name="onboarding_repeat">Repetir</string>
    <string name="onboarding_other_method">Outro método</string>
    <string name="onboarding_method_acoustic">Acústico</string>
    <string name="onboarding_method_loopback">Cabo de loopback</string>
    <string name="onboarding_method_tap">Tocar junto</string>
    <string name="onboarding_method_leak">Teste de vazamento</string>
    <string name="onboarding_acoustic_phone">O celular toca sons curtos e o microfone capta. Se você vai ouvir por fone, conecte-o e encoste um lado do fone no microfone. Fique em silêncio.</string>
    <string name="onboarding_acoustic_earbud">Encoste um lado do fone no microfone do celular, com volume médio. O celular toca sons curtos por ele. Fique em silêncio.</string>
    <string name="onboarding_loopback_text">Ligue a saída da interface na entrada dela com um cabo. É o método mais preciso para interfaces.</string>
    <string name="onboarding_tap_text">Ouça 4 cliques e depois toque ou bata junto com os próximos 16. Funciona com qualquer equipamento, mas é menos preciso.</string>
    <string name="onboarding_leak_text">Verifica se a interface devolve na entrada o que o celular toca. Deixe o instrumento em silêncio.</string>
    <string name="onboarding_running_acoustic">Tocando sons de teste… Fique em silêncio.</string>
    <string name="onboarding_running_loopback">Tocando sons de teste pelo cabo…</string>
    <string name="onboarding_running_tap">Ouça 4 cliques e depois toque ou bata junto com os próximos 16, o mais preciso que conseguir.</string>
    <string name="onboarding_running_leak">Tocando sons de teste… Deixe o instrumento em silêncio.</string>
    <string name="onboarding_result">Ida e volta: %1$s ms</string>
    <string name="onboarding_result_details">Dispersão de %1$s ms, %2$d de %3$d medições usadas.</string>
    <string name="onboarding_result_spread_high">As medições variaram mais de 1 ms. Repetir num lugar mais silencioso pode dar um resultado melhor.</string>
    <string name="onboarding_result_saved">Salvo para esta saída e entrada.</string>
    <string name="onboarding_leak_found">Vazamento detectado (%1$s dB): a entrada devolve o que o celular toca, então as trilhas antigas apareceriam nas gravações novas. Se a interface tiver uma chave de loopback ou “mix do celular”, desligue. Isso foi salvo no perfil.</string>
    <string name="onboarding_leak_not_found">Sem vazamento: a entrada não devolve o que o celular toca. Isso foi salvo no perfil.</string>
    <string name="onboarding_failed_no_signal">Os sons de teste não foram detectados. Confira o volume, o cabo ou a posição do fone e tente de novo.</string>
    <string name="onboarding_failed_inconsistent">As medições não bateram entre si. Tente de novo num lugar mais silencioso.</string>
    <string name="onboarding_failed_interrupted">A medição foi interrompida (o dispositivo de áudio mudou ou o áudio parou).</string>
    <string name="onboarding_calibration_later">Você pode pular e calibrar depois, no gravador (Calibrar / testar).</string>
