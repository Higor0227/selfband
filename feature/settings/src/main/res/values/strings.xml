    <string name="onboarding_welcome">Welcome to Selfband</string>
    <string name="onboarding_welcome_text">Record each part of a song yourself, one at a time, with video, all in sync. A few steps to get ready. First, the permissions:</string>
    <string name="onboarding_perm_mic">Microphone</string>
    <string name="onboarding_perm_mic_text">To record sound and to measure the latency.</string>
    <string name="onboarding_perm_camera">Camera</string>
    <string name="onboarding_perm_camera_text">To record the video of each track. Without it, tracks are audio only.</string>
    <string name="onboarding_perm_notifications">Notifications</string>
    <string name="onboarding_perm_notifications_text">To show the export progress while the app is in the background.</string>
    <string name="onboarding_perm_granted">Allowed</string>
    <string name="onboarding_perm_missing">Not allowed</string>
    <string name="onboarding_perm_allow">Allow</string>
    <string name="onboarding_perm_later">You can allow it later in Android’s app settings. The app also asks again when it needs it.</string>
    <string name="onboarding_perm_all_granted">All set.</string>
    <string name="onboarding_setup_title">How do you record?</string>
    <string name="onboarding_setup_phone">Phone microphone</string>
    <string name="onboarding_setup_phone_text">The phone’s own mic. Listen to the tracks on headphones, or they leak into the new recording.</string>
    <string name="onboarding_setup_wired">Wired headphones</string>
    <string name="onboarding_setup_wired_text">Headphones or a headset with a cable, recording with the phone or headset mic.</string>
    <string name="onboarding_setup_usb">USB interface</string>
    <string name="onboarding_setup_usb_text">Audio interface, pedalboard or USB microphone.</string>
    <string name="onboarding_setup_bluetooth">Bluetooth</string>
    <string name="onboarding_setup_bluetooth_text">For listening only, with high latency (150 to 300 ms). The sound is recorded by the phone mic.</string>
    <string name="onboarding_connected">Connected now: %1$s</string>
    <string name="onboarding_setup_not_connected">This equipment is not connected right now. Connect it before calibrating: the app detects it by itself.</string>
    <string name="onboarding_calibration_title">Calibration</string>
    <string name="onboarding_calibration_text">Measures the delay between what the phone plays and what it records, so the tracks line up. It is saved for this output and input, and loaded whenever they are connected again.</string>
    <string name="onboarding_calibration_no_mic">Without the microphone permission the latency cannot be measured. You can calibrate later in the recorder.</string>
    <string name="onboarding_engine_error">Could not open the audio: %1$s</string>
    <string name="onboarding_output">Output: %1$s</string>
    <string name="onboarding_input">Input: %1$s</string>
    <string name="onboarding_already_calibrated">Already calibrated: round trip %1$s ms.</string>
    <string name="onboarding_bluetooth_warning">Bluetooth adds 150 to 300 ms and can vary. Calibrate with the headphones you will use; wired headphones are more precise.</string>
    <string name="onboarding_recommended">Recommended</string>
    <string name="onboarding_start">Start</string>
    <string name="onboarding_repeat">Repeat</string>
    <string name="onboarding_other_method">Other method</string>
    <string name="onboarding_method_acoustic">Acoustic</string>
    <string name="onboarding_method_loopback">Loopback cable</string>
    <string name="onboarding_method_tap">Play along</string>
    <string name="onboarding_method_leak">Playback leak test</string>
    <string name="onboarding_acoustic_phone">The phone plays short sounds and its microphone picks them up. If you will listen on headphones, plug them in and hold one earbud against the mic. Stay quiet.</string>
    <string name="onboarding_acoustic_earbud">Hold one earbud against the phone’s microphone, at medium volume. The phone plays short sounds through it. Stay quiet.</string>
    <string name="onboarding_loopback_text">Connect the interface output to its input with a cable. The most precise method for interfaces.</string>
    <string name="onboarding_tap_text">Listen to 4 clicks, then play or tap along with the next 16. Works with any equipment, but is less precise.</string>
    <string name="onboarding_leak_text">Checks whether the interface sends what the phone plays back into its input. Keep your instrument silent.</string>
    <string name="onboarding_running_acoustic">Playing test sounds… Stay quiet.</string>
    <string name="onboarding_running_loopback">Playing test sounds through the cable…</string>
    <string name="onboarding_running_tap">Listen to 4 clicks, then play or tap along with the next 16, as tight as you can.</string>
    <string name="onboarding_running_leak">Playing test sounds… Keep your instrument silent.</string>
    <string name="onboarding_result">Round trip: %1$s ms</string>
    <string name="onboarding_result_details">Spread %1$s ms, %2$d of %3$d measurements used.</string>
    <string name="onboarding_result_spread_high">The measurements varied more than 1 ms. Repeating in a quieter place may give a better result.</string>
    <string name="onboarding_result_saved">Saved for this output and input.</string>
    <string name="onboarding_leak_found">Leak detected (%1$s dB): the input returns what the phone plays, so old tracks would be heard in new recordings. If the interface has a loopback or “phone mix” switch, turn it off. This was saved to the profile.</string>
    <string name="onboarding_leak_not_found">No leak: the input does not return what the phone plays. This was saved to the profile.</string>
    <string name="onboarding_failed_no_signal">The test sounds were not detected. Check the volume, the cable or the earbud position, and try again.</string>
    <string name="onboarding_failed_inconsistent">The measurements did not agree with each other. Try again in a quieter place.</string>
    <string name="onboarding_failed_interrupted">The measurement was interrupted (the audio device changed or the audio stopped).</string>
    <string name="onboarding_calibration_later">You can skip this and calibrate later in the recorder (Calibrate / test).</string>
